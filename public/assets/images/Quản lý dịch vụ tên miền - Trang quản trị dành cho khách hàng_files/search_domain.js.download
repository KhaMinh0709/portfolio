// Gửi mail xác nhận
function sentMail(domainId = null, email = null){
    
    var url = '/Domain/sentMail';
    var csrfToken = $('input[name="_csrfToken"]').val();
    var dataPost = {
        domainId : domainId,
        email : email
    };
    var type = 'json';
    var method = 'POST';
    $('#confirmSendMail').modal('hide');
    callAjax(url, dataPost, type, method,csrfToken , 1).then(res => {
        notifyModel(); 
        $('#notify').html(res.msg); 
    });     
}
//Đổi mật khẩu domain
function ChangePassDomain(domain_name = null ,domainId = null, created_date = null, expiration_date = null, count_date = null){
    if (count_date >= 0) {
        $('.ul-tog-domain').hide();
        var loadding = '<div class="loading_spinner" style="margin-top: 0px !important;"></div>';
        var csrfToken = $('input[name="_csrfToken"]').val();
        $('#content-pass').html(loadding);
        var url = '/Domain/changePassword';
        var dataPost = {
            domain_name : domain_name,
            domainId : domainId,
            created_date : created_date,
            expiration_date : expiration_date
        };
        var type = 'html';
        var method = 'POST';
        callAjax(url, dataPost, type, method,csrfToken , 0).then(res => {
            $('#content-pass').html(res);
            $('#change_pass').modal('show');
        });
    }else{
        var Url = window.location.origin;
        $(location).attr('href', Url+'/Report/index?service=domain');
    }
    
}