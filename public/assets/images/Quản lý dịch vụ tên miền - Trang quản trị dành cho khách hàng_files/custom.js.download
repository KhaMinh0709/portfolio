jQuery(document).ready(function() {
    // SHOW LIST UL
    jQuery('.click-ul-tog').click(function(e) {
        jQuery(this).find('.ul-tog').slideToggle(300).click(function(e_ul) {
            e_ul.stopPropagation();
        });
        jQuery('.click-ul-tog').not(this).find('.ul-tog').hide();
    });

    jQuery(document).click(function(event) {
        //if you click on anything except the modal itself or the "open modal" link, close the modal
        if (!jQuery(event.target).closest(".ul-tog, .click-ul-tog").length) {
            jQuery("body").find(".ul-tog").hide();
        }

    });

    $('ul.tab_content_choose_parts li').click(function() {
        var tab_id = $(this).attr('data-tab');
        jQuery('ul.tab_content_choose_parts li').removeClass('currents');
        jQuery('.tabs-contents').removeClass('currents');
        jQuery(this).addClass('currents');
        jQuery("#" + tab_id).addClass('currents');
    })

    jQuery('[data-toggle="tooltip"]').tooltip({
        container: 'body'
    });
    jQuery('ul.menu').children().find('ul.sub-menu').children().has('ul.sub-menu').click(function() {
        jQuery(this).find('ul.sub-menu').stop().slideToggle();
    });

    jQuery('ul.menu li').has('ul.sub-menu').addClass('menu-item-has-children');

    // menu up
    jQuery('.menu_up ul.menu>li').click(function() {
        jQuery(this).stop().toggleClass('active');
        jQuery(this).siblings().removeClass('active');
        jQuery('.menu_down').find('li').removeClass('active');
        jQuery('.menu_down').find('li').removeClass('menu_down_mobile');
        jQuery(this).children('ul').slideToggle();
        jQuery(this).siblings().has('ul.sub-menu').find('ul.sub-menu').slideUp();
        jQuery('.menu_down').find('ul.sub-menu').slideUp();
    }).children('ul').children().click(function(event) {
        event.stopPropagation();
    });

    jQuery('.menu_up>ul.menu>li>ul.sub-menu>li').click(function() {
        jQuery('.menu-fixed-nv2021').css('overflow-y', 'inherit');
        jQuery(this).stop().toggleClass('active');
        jQuery(this).siblings().removeClass('active');
        jQuery('.menu_down').find('li').removeClass('active');
        jQuery('.menu_down').find('li').removeClass('menu_down_mobile');
        jQuery(this).siblings().has('ul.sub-menu').find('ul.sub-menu').slideUp();
    }).children('ul').children().click(function(event) {
        event.stopPropagation();
    });
    // end menu up cap 3

    $(document).on('scroll', function() {
      if ($(this).scrollTop() >= $('.menu-fixed-nv2021').position().top) {
        jQuery('.menu-fixed-nv2021').css('overflow-y','auto');
    }
    clearTimeout($.data(this, 'scrollTimer'));
    $.data(this, 'scrollTimer', setTimeout(function() {
        // do something
        //console.log("Haven't scrolled in 250ms!");
        jQuery('.menu-fixed-nv2021').css('overflow-y','inherit');
    }, 2000));
})

    // menu down
    jQuery('.menu_down ul.menu').children().click(function() {
        jQuery('.menu-fixed-nv2021').css('overflow-y', 'inherit');
        jQuery(this).addClass('active').siblings().removeClass('active');
        jQuery('.menu_up').find('li').removeClass('active');
        jQuery(this).children('ul').slideToggle();
        jQuery(this).siblings().has('ul.sub-menu').find('ul.sub-menu').slideUp();
        jQuery(this).siblings().find('ul.sub-menu>li').has('ul.sub-menu').removeClass('menu_down_mobile');
        jQuery('.menu_up').find('ul.sub-menu').slideUp();
        jQuery('.menu_up ul.menu>li').removeClass('active');
    }).children('ul').children().click(function(event) {
        event.stopPropagation();
    });

    jQuery('.menu_down ul.menu li').has('ul.sub-menu').click(function(event) {
        jQuery(this).toggleClass('menu_down_mobile');
    });
    jQuery('.menu_down>ul.menu>li').click(function() {
        $(this).siblings().removeClass('menu_down_mobile');
    });

    jQuery('.scroll_menu_fixed').click(function() {
        jQuery(".menu-fixed-nv2021").toggleClass('to_left');
        jQuery(this).toggleClass('tg_active');
        jQuery('#qb_content_navi_2021').toggleClass('content_to_left');
        jQuery('.menu-fixed-nv2021 ul.menu>li>a:nth-child(1)').toggleClass('hide');
        jQuery('.menu-fixed-nv2021 ul.menu>li>a:nth-child(2),.menu-fixed-nv202  ul.menu>li p').toggleClass('show');
        jQuery('.menu-fixed-nv2021 ul.menu>li').removeClass('active menu_up_mobile');
        jQuery('.menu-fixed-nv2021 ul li').children('.sub-menu').slideUp();
    });

    jQuery('.imgmn_to_left').click(function(e) {
