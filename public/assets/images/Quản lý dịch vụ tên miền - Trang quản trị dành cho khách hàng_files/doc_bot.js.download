                placeholder: "What can I do for you?",
                name: "Name",
                nameRequire: "Please enter a name",
                email: "Email",
                emailRequire: "Please enter email",
                phone: "Phone number",
                phoneRequire: "Please enter the phone number",
                start: "Start",
                message: "Message",
                messageRequire: "Please enter message",
                back: "Back",
                send: "Send",
                confirm: "The system has received the information and will contact you as soon as possible!",
            }, jp: {
                today: "今日",
                placeholder: "お手伝いできることはありますか？",
                name: "お名前",
                nameRequire: "お名前を入力してください",
                email: "メール",
                emailRequire: "メールアドレスを入力してください",
                phone: "電話番号",
                phoneRequire: "電話番号を入力してください",
                start: "始める",
                message: "メッセージ",
                messageRequire: "メッセージを入力してください",
                back: "戻る",
                send: "送信",
                confirm: "システムは情報を受け取り、できるだけ早くお客様にご連絡いたします！",
            },
        };

        div.id = 'tenten-iframe-' + Date.now().toString(36) + Math.random().toString(36).substr(2, 9);

        div.classList.add('tenten-iframe');

        document.body.appendChild(div);

        const style = document.createElement("style");

        if (window.setting.type_noitisop === '0') {
            nt_type = 'left';
        } else {
            nt_type = 'right';
        }

        const __ = function (key) {
            if (languages[window.setting.lang] && languages[window.setting.lang][key]) {
                return languages[window.setting.lang][key];
            } else {
                return ``;
            }
        }

        const getCookie = function () {
            const nameEQ = 'MiraBotIDClient415' + window.setting.id;
            const cookies = document.cookie.split(';');

            for (let i = 0; i < cookies.length; i++) {
                let cookie = cookies[i];
                while (cookie.charAt(0) === ' ') {
                    cookie = cookie.substring(1, cookie.length);
                }
                if (cookie.indexOf(nameEQ) === 0) {
                    return cookie.substring(nameEQ.length + 1, cookie.length);
                }
            }

            return null;
        }

        const getCurrentTime = function () {
            const now = new Date();
            let hours = now.getHours();
            let minutes = now.getMinutes();
            let amOrPm = hours >= 12 ? 'PM' : 'AM';

            hours = hours % 12 || 12;

            hours = hours < 10 ? '0' + hours : hours;
            minutes = minutes < 10 ? '0' + minutes : minutes;

            return hours + ':' + minutes + ' ' + amOrPm;
        }

        let email = '';
        let name = '';
        let phone = '';
        let client = '';
        let token = '';
        let bot_t = '';
        let bot_token = '';
        let status = '';
        const cookie = getCookie();
        if (window.setting.user_information === '1') {
            const cookieValue = JSON.parse(decodeURIComponent(cookie));

            if (!cookie || cookieValue.type === '0') {
                user_info = 'active';
            } else {
                email = cookieValue.email;
                name = cookieValue.name;
                phone = cookieValue.phone;
                client = cookieValue.client_id;
                status = 'disabled';
            }
        }

        style.innerHTML = ".tenten-iframe { position: fixed; right: 9px; bottom: 14px; z-index: 9999; }";

        const head = document.head || document.getElementsByTagName("head")[0];

        head.appendChild(style);

        const iframe = document.createElement('iframe');
        iframe.classList.add('iframe-tenten-bot');

        iframe.style.border = 'none';

        iframe.style.setProperty('width', `${window.setting.width}px`, 'important');
        iframe.style.setProperty('height', `${window.setting.height}px`, 'important');

        div.appendChild(iframe);

        const iframeDocument = iframe.contentDocument || iframe.contentWindow.document;
        const ic_0 = '';
        const ic_1 = 'bt-chatmira01.svg';
        const ic_2 = 'bt-chatmira02.svg';
        const ic_3 = 'bt-chatmira03.svg';
        const ic_4 = 'bt-chatmira04.svg';
        const ic_5 = 'chat-bot5.png';
        const ic_7 = 'bt-chatmira07.svg';
        const avt_0 = '';
        const avt_1 = 'chat-bot1.svg';
        const avt_2 = 'chat-bot2.svg';
        const avt_3 = 'chat-bot3.svg';
        const avt_4 = 'chat-bot4.svg';
        const avt_5 = 'chat-bot5.png';

        switch (window.setting.ic_chat) {
            case 'ic_1':
                svg_ic = 'src="' + link + '/assets/images/' + ic_1 + '"';
                break;

            case 'ic_2':
                svg_ic = 'src="' + link + '/assets/images/' + ic_2 + '"';
                break;

            case 'ic_3':
                svg_ic = 'src="' + link + '/assets/images/' + ic_3 + '"';
                break;

            case 'ic_4':
                svg_ic = 'src="' + link + '/assets/images/' + ic_4 + '"';
                break;

            case 'ic_5':
                svg_ic = 'src="' + link + '/assets/v2/images/' + ic_5 + '"';
                break;

            case 'ic_7':
                svg_ic = 'src="' + link + '/assets/images/' + ic_7 + '"';
                break;

            case 'ic_custom':
                svg_ic = 'src="' + window.setting.icon + '"';
                break;

            default:
                svg_ic = ic_0;
        }

        switch (window.setting.avt_chat) {
            case 'ic_1':
                svg_avt = 'src="' + link + '/assets/images/' + avt_1 + '"';
                break;

            case 'ic_2':
                svg_avt = 'src="' + link + '/assets/images/' + avt_2 + '"';
                break;

            case 'ic_3':
                svg_avt = 'src="' + link + '/assets/images/' + avt_3 + '"';
                break;

            case 'ic_4':
                svg_avt = 'src="' + link + '/assets/images/' + avt_4 + '"';
                break;

            case 'ic_5':
                svg_avt = 'src="' + link + '/assets/v2/images/' + avt_5 + '"';
                break;

            case 'ic_custom':
                svg_avt = 'src="' + window.setting.avatar + '"';
                break;

            default:
                svg_avt = avt_0;
        }

        iframeDocument.open();
        iframeDocument.write(`<!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <title>Chat Bot</title>
            </head>
            <body>
            <div class="mc_chatbox_mirabot">
                <div class="mc_btn_help_chatbox">
                    <img alt="" class="show-help-chatbot"
                         src="https://img.tenten.vn/t/new-2023/admin-mira-bot-14122023-ver2/images/bot-chat-11232023.svg">
                    <img alt="" class="close-help-chatbot"
                         src="https://img.tenten.vn/t/new-2023/admin-mira-bot-14122023-ver2/images/bot-chat-11232023-close-icon.svg">
                    <span>Trợ giúp</span>
                </div>
                <div class="mc_content_chatbox">
                    <div class="mirabot_chatbox_142024">
                        <div class="chatbox_142024_title">
                            <div class="chatbox_142024_left">
                                <figure><img src="https://img.tenten.vn/t/new-2023/admin-mira-bot-14122023-ver2/images/bot-chat-11232023.svg" alt=""><span class="chatbox_142024_active"></span></figure>
                                <strong>Chat với chúng tôi</strong>
                            </div>
                            <div class="chatbox_142024_right">
                                <figure class="chatbox_142024_close"><img src="https://img.tenten.vn/t/new-2023/admin-mira-bot-14122023-ver2/images/bot-chat-11232023-close-icon.svg" alt=""></figure>
                            </div>
                        </div>
                        <div class="chatbox_142024_general">
                            <div class="mc_list_service">
                                <ul>
                                    <li service-tab="mc-service-1" data-number_bot="1"><a href="#">Tên miền</a></li>
                                    <li service-tab="mc-service-2" data-number_bot="2"><a href="#">Hosting</a></li>
                                    <li service-tab="mc-service-3" data-number_bot="3"><a href="#">Email</a></li>
                                </ul>
                            </div>
                            <div class="chatbox_142024_form_bg">
                                <div class="chatbox_142024_chatbot tenten-conversation" data-service_tab="default">
                                    <div class="chatbox_142024_detailds">
                                        <div class="chatbox_line_box bot_ans_chat">
                                            <div class="mc_avatar_chatbox">
                                                <figure><img src="https://img.tenten.vn/t/new-2023/admin-mira-bot-14122023-ver2/images/bot-chat-11232023.svg" alt=""></figure>
                                            </div>
                                            <div class="txt_chatbox_right">
                                                <span class="txt_chatbox_date">${getCurrentTime()}</span>
                                                <div class="chatbox_142024_inside">
                                                    <p>Quý khách vui lòng chọn Dịch vụ</p>
