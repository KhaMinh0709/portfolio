                    `
                    case 4:
                        let html = `<div class="conversation_source"><strong class="Sources-update1123">Sources<img class="" src="${link}/assets/v2/images/mirabot-14122023-arr-converbox-icon.svg" alt=""></strong><ul class="source-list">`;
                        const links = message;
                        const hasLinks = Array.isArray(links) && links.length > 0;
                        const fileNameCheck = /^[a-zA-Z0-9-_]+\.[a-zA-Z0-9]+$/;

                        if (hasLinks) {
                            links.forEach(function (linkDocument) {
                                const fileName = linkDocument.substring(linkDocument.lastIndexOf('/') + 1);
                                if (fileNameCheck.test(fileName)) {
                                    html += `
                                        <li class="link-file-update1123">
                                            <img alt="" src="${link}/assets/images/file-update11232023.svg">
                                            <a class="mc_source_link" href="${linkDocument}">${fileName}</a>
                                        </li>
                                    `
                                } else {
                                    html += `
                                        <li class="link-file-update1123">
                                            <img alt="" src="${link}/assets/images/link-update11232023.svg">
                                            <a class="mc_source_link" href="${linkDocument}">${linkDocument}</a>
                                        </li>
                                    `
                                }
                            });
                        }

                        html += `</ul></div>`;

                        return html;
                    case 5:
                        return `
                        <div class="mc_support_box">
                           <div class="mc_spbox_inner mc_txt_chatbox">
                               <span>${__('unsatisfied')}</span>
                               <a class="mc_btn_send_form_icon" href="#">
                                   ${__('contactUs')}
                                   <img alt="" src="${link}assets/images/contact-update-1124.svg">
                               </a>
                           </div>
                       </div>
                    `

                    case 6:
                        return `
                        <img alt="" src="${message}">
                    `

                    case 7:
                        return `
                        <em class="liveChatPopup"><a class="mc_powerby_link" href="https://zalo.me/925364523540055953">Gặp nhân viên kinh doanh</a></em>
                    `
                }
            };

            const generateReplyElement = function (msg) {
                ws.send(msg);
            }

            buttonTenten.addEventListener('click', async function () {
                const textareaValue = textarea.value;

                if (textareaValue.trim() !== '') {
                    messageProcessing(textareaValue);
                }
            });

            const textarea_input = document.getElementById("data_chat_bot");
            textarea_input.addEventListener("keydown", function (event) {
                if (event.keyCode === 13) {
                    event.preventDefault();
                    const textareaValue = textarea.value;

                    if (textareaValue.trim() !== '') {
                        messageProcessing(textareaValue);
                    }
                }
            });

            const messageProcessing = function ($msg) {
                buttonTenten.disabled = true;
                spinner.style.display = 'block';
                buttonTenten.style.display = 'none';
                textarea.value = '';
                conversationElement.scrollTop = conversationElement.scrollHeight;
                generateReplyElement($msg);
            }
        };

        window.bot = {
            "svg_ic": svg_ic, "svg_avt": svg_avt, "cookie": cookie, "client": client,
        }

        const script = document.createElement('script');
        script.type = 'text/javascript';

        script.textContent = '(' + scripts.toString() + ')(' + JSON.stringify(window.setting) + ', ' + JSON.stringify(window.bot) + ', ' + JSON.stringify(window.config) + ');';

        iframeDocument.body.appendChild(script);

        iframeDocument.close();
    }

    window.addEventListener('message', function (event) {
        if (event.data.action === 'openNewTab') {
            const newTab = window.open(event.data.url, '_blank');
            newTab.focus();
        }
    });
})();
