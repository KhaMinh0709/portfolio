    makeBot();

    function makeBot() {
        let svg_avt;
        let svg_ic;
        let nt_type;
        let user_info = '';
        const link = window.config.url;

        const div = document.createElement('div');

        const languages = {
            vi: {
                today: "Hôm nay",
                placeholder: "Tôi có thể giúp gì cho bạn?",
                name: "Tên",
                nameRequire: "Vui lòng nhập tên",
                email: "Email",
