jQuery(document).on('click', '.tknc_btn button[type=submit]', function(event) {
	event.preventDefault();
	searchDomain();
});
//search
function searchDomain(date = ''){
	var record = ($('#record').val() != '') ? $('#record').val() : null;
	var domainName = ($('#domainName').val() != '') ? $('#domainName').val() : null;
	var status = ($('#status').val() != '') ? $('#status').val() : null;
	var domainType = ($('#domainType').val() != '') ? $('#domainType').val() : null;
	var start_date = ($('#start_date').val() != '') ? $('#start_date').val() : null;
	var end_date = ($('#end_date').val() != '') ? $('#end_date').val() : null;
	var flgSExp = ($('#flgSexp').val() != '') ? $('#flgSexp').val() : null;
	var autoRenew = ($('#auto_renew').val() != '') ? $('#auto_renew').val() : null;
	var csrfToken = $('input[name="_csrfToken"]').val();
	var url = '/Domain/seachDomain';
    var dataPost = {
    	domainName : domainName,
		domainType : domainType,
		start_date : start_date,
		end_date : end_date,
		status : status,
		flgSExp : flgSExp,
		limit : record,
        date : date,
		autoRenew : autoRenew
    };
    var type = 'html';
    var method = 'POST';
    callAjax(url, dataPost, type, method, csrfToken, 1).then(res => {
        $('.domain_name_service_management_ct .mobile_interface').html(res);
        $('#record>[value='+record+']').attr('selected',true);
        sroll_search();
    });
}

jQuery(function() {
    jQuery('.date').datetimepicker({format: 'YYYY-MM-DD'});
});

//pagination
jQuery(document).on('click', '.page_number a', function(event) {
    event.preventDefault();
    var record = ($('#record').val() != '') ? $('#record').val() : null;
    var domainName = ($('#domainName_1').val() != '') ? $('#domainName_1').val() : null;
    var domainType = ($('#domainType_1').val() != '') ? $('#domainType_1').val() : null;
    var start_date = ($('#start_date_1').val() != '') ? $('#start_date_1').val() : null;
    var end_date = ($('#end_date_1').val() != '') ? $('#end_date_1').val() : null;
    var status = ($('#status_1').val() != '') ? $('#status_1').val() : null;
    var flgSExp = ($('#flgSExp_1').val() != '') ? $('#flgSExp_1').val() : null;
    var csrfToken = $('input[name="_csrfToken"]').val();
    var now_page = $('#page').val();
    var page_count = $('#page_count').val();
    var autoRenew = ($('#autoRenew_1').val() != '') ? $('#autoRenew_1').val() : null;
    var sort_create = ($('#sort_create_date_1').val() != '') ? $('#sort_create_date_1').val() : null;
    var sort_exp = ($('#sort_exp_date_1').val() != '') ? $('#sort_exp_date_1').val() : null;

    var page = $(this).text();

    if ($(this).data('id') == 1) {
        page = 1;
    }else if($(this).data('id') == page_count){
        page = page_count;
    }

    if (page == now_page) {
        return false;
    }

    var sort = 0;
    var name = 'sort_create_date';

    if (sort_create != 0) {
        sort = sort_create;
        name = 'sort_create_date';
    }else if (sort_exp != 0){
        sort = sort_exp;
        name = 'sort_exp_date';
    }

    var url = '/Domain/seachDomain';
    var dataPost = {
        domainName : domainName,
        domainType : domainType,
        start_date : start_date,
        end_date : end_date,
        page : page,
        status : status,
        flgSExp : flgSExp,
        limit : record,
        autoRenew : autoRenew,
        sort_create : sort_create,
        sort_exp : sort_exp,
    };
    var type = 'html';
    var method = 'POST';

    callAjax(url, dataPost, type, method,csrfToken, 1).then(res => {
        $('.domain_name_service_management_ct .mobile_interface').html(res);
        $('#record>[value='+record+']').attr('selected',true);
        if (sort == 1) {
            $('.'+name).find('span.i-con').html('<i class="fa fa-sort-desc" aria-hidden="true"></i>');
        }else{
            $('.'+name).find('span.i-con').html('<i class="fa fa-sort-asc" aria-hidden="true"></i>');
        }
        $('.'+name).data('id',sort);
        sroll_search();
    });
});
